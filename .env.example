# Postgres in every environment (this project deploys on Neon via the Vercel
# Marketplace integration, which injects DATABASE_URL + DATABASE_URL_UNPOOLED
# automatically). DATABASE_URL_UNPOOLED is Neon's direct connection, used by
# Prisma for `db push` / migrate; DATABASE_URL is the pooled one the app uses.
DATABASE_URL="postgresql://user:pass@host/db?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:pass@host/db?sslmode=require"

# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Optional — enables the "Continue with Google" button.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID="xxxx.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="xxxx"

# GeM Sahayak chatbot (server-side only, never exposed to the browser).
# The route picks the first configured backend, in this order:
#   1. IBM watsonx.ai  — set all four WATSONX_* below
#   2. Anthropic Claude — set ANTHROPIC_API_KEY
#   3. Local knowledge base — no config needed; canned answers for GeM topics
#
# WATSONX_API_KEY="your-ibm-cloud-api-key"
# WATSONX_PROJECT_ID="310e9ef4-c3a3-413e-90d4-acfffb6fdece"
# WATSONX_URL="https://eu-de.ml.cloud.ibm.com"
# WATSONX_MODEL_ID="ibm/granite-4-h-small"
#
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_MODEL="claude-3-5-sonnet-20240620"   # optional, this is the default
# ANTHROPIC_WORKSPACE_ID="..."                   # only if the key is org-scoped (not tied to a workspace)

# Base URL of the FastAPI compliance engine (public tender feed, cartel check,
# vendor sandbox). Locally this is your own uvicorn; in production it's wherever
# the backend/ service is deployed (this project uses Railway).
# NEXT_PUBLIC_ENGINE_URL="http://localhost:8000"
# NEXT_PUBLIC_ENGINE_URL="https://your-backend.up.railway.app"
