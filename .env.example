# Local / demo uses SQLite. For production, use Postgres:
#   DATABASE_URL="postgresql://user:pass@host:5432/gemverify"
# and set  provider = "postgresql"  in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# Generate with: npx auth secret   (or: openssl rand -base64 33)
AUTH_SECRET="replace-with-a-long-random-string"
AUTH_TRUST_HOST="true"

# Optional — enables the "Continue with Google" button.
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: http://localhost:3000/api/auth/callback/google
# AUTH_GOOGLE_ID="xxxx.apps.googleusercontent.com"
# AUTH_GOOGLE_SECRET="xxxx"

# GeM Sahayak chatbot — IBM watsonx.ai (server-side only, never exposed to the browser).
# The API key is exchanged for a short-lived IAM token by /api/chat.
# WATSONX_API_KEY="your-ibm-cloud-api-key"
# WATSONX_PROJECT_ID="310e9ef4-c3a3-413e-90d4-acfffb6fdece"
# WATSONX_URL="https://eu-de.ml.cloud.ibm.com"
# WATSONX_MODEL_ID="ibm/granite-4-h-small"

# Optional — base URL of the FastAPI compliance engine (public tender feed).
# NEXT_PUBLIC_ENGINE_URL="http://localhost:8000"
