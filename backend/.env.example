# Copy to .env and adjust. All keys are prefixed GEMV_.

GEMV_ENVIRONMENT=development

# Mock government sandbox
GEMV_MOCK_API_KEY=sandbox_demo_key
GEMV_MOCK_LATENCY_MIN_MS=80
GEMV_MOCK_LATENCY_MAX_MS=600

# Decoupled Next.js frontend (CORS allow-list) — JSON array
GEMV_FRONTEND_ORIGINS=["http://localhost:3000"]

# AI evaluation engine — Claude Vision (POST /v1/ai/extract)
# Create a key at https://console.anthropic.com/settings/keys — never commit it.
# GEMV_ANTHROPIC_API_KEY and ANTHROPIC_API_KEY are both accepted.
GEMV_ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx-replace-with-your-own-key
GEMV_ANTHROPIC_MODEL=claude-3-5-sonnet-20240620
# Newer, more accurate option once you have access:
# GEMV_ANTHROPIC_MODEL=claude-sonnet-5

# Phase 3+
GEMV_DATABASE_URL=postgresql+asyncpg://gemv:gemv@localhost:5432/gemv
GEMV_REDIS_URL=redis://localhost:6379/0
